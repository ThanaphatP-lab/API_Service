# Never commit real tokens. Generate two different values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
API_DOCS_ENABLED=false
LEGACY_ENDPOINTS_ENABLED=false

# Backend -> public Model Gateway
MODEL_GATEWAY_API_KEY=replace-with-at-least-32-random-characters
# Set only during a rolling rotation, then remove it.
MODEL_GATEWAY_API_KEY_PREVIOUS=

# Gateway/Pipelines -> internal Pipeline/Leaf services
INTERNAL_API_TOKEN=replace-with-a-different-32-character-random-secret
# Set only during a rolling rotation, then remove it.
INTERNAL_API_TOKEN_PREVIOUS=

# When Nginx is on the same host, keep Uvicorn private.
GATEWAY_HOST=127.0.0.1
INTERNAL_SERVICE_HOST=127.0.0.1
GATEWAY_BIND_ADDRESS=127.0.0.1
DEMO_BIND_ADDRESS=127.0.0.1
TRUST_PROXY_HEADERS=true

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RATE_LIMIT_KEYS=10000
MAX_REQUEST_MB=28
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_BATCH_IMAGES=64
MAX_BATCH_UPLOAD_MB=64
# Must not exceed MAX_BATCH_IMAGES on the recognition leaf.
OCR_RECOGNITION_BATCH_SIZE=64
MAX_CONCURRENT_REQUESTS=1
GATEWAY_MAX_CONCURRENT_REQUESTS=4
INFERENCE_QUEUE_TIMEOUT_SECONDS=5
DEBUG_ERRORS=false

GATEWAY_ENABLED_PIPELINES=all
GATEWAY_REQUIRED_PIPELINES=
GATEWAY_READINESS_TIMEOUT_SECONDS=10

# Optional override. Defaults to <project>/model_variants.json.
MODEL_VARIANTS_CONFIG=

# Optional TableRecognitionPipelineV2 overrides. These defaults match
# coop-project-4 (4).ipynb.
TABLE_V2_WIRED_MODEL_NAME=SLANeXt_wired
TABLE_V2_WIRELESS_MODEL_NAME=SLANeXt_wireless
TABLE_V2_OCR_VERSION=v5
TABLE_V2_MODEL_CACHE_SIZE=2
TABLE_V2_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
TABLE_V2_TEXT_RECOGNITION_MODEL_NAME=th_PP-OCRv5_mobile_rec

# Gateway is server-to-server by default, so leave CORS disabled unless a
# browser must call it directly. Prefer Backend -> Gateway instead.
CORS_ORIGINS=
