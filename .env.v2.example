MODEL_IMAGE=api-service-model-v2:latest

# Separate host ports so the old Compose project can keep running.
LAYOUT_PORT=18001
DET_V5_PORT=18002
DET_V6_PORT=18003
REC_TH_PORT=18004
OCR_CUSTOM_PORT=18005
OCR_PADDLE_PORT=18006
TABLE_WIRED_PORT=18007
TABLE_WIRELESS_PORT=18008
SIGLIP_PORT=18009
LAYOUT_PIPELINE_PORT=18010
TABLE_PIPELINE_PORT=18011
IMAGE_VERIFICATION_PORT=18012
TABLE_V2_PORT=18013
GATEWAY_PORT=18080
DEMO_PORT=18501

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RATE_LIMIT_KEYS=10000
MAX_UPLOAD_MB=20
GATEWAY_ENABLED_PIPELINES=all
GATEWAY_REQUIRED_PIPELINES=
GATEWAY_READINESS_TIMEOUT_SECONDS=10

# Development may leave these empty. Production requires separate random
# values of at least 32 characters and APP_ENV=production.
APP_ENV=development
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_API_KEY_PREVIOUS=
INTERNAL_API_TOKEN=
INTERNAL_API_TOKEN_PREVIOUS=
MAX_REQUEST_MB=28
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_BATCH_IMAGES=64
MAX_BATCH_UPLOAD_MB=64
OCR_RECOGNITION_BATCH_SIZE=64
MAX_CONCURRENT_REQUESTS=1
GATEWAY_MAX_CONCURRENT_REQUESTS=4
INFERENCE_QUEUE_TIMEOUT_SECONDS=5
