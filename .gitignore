# -----------------------------------------------------------------------------
# Secrets and local environment configuration
# -----------------------------------------------------------------------------
# Git hygiene, not a production deployment manifest. Keep source, tests, READMEs,
# requirements, model_variants.json and sanitized *.example files versioned.
.env
.env.*
.envrc
!.env.example
!.env.*.example
/secrets/
/credentials/
/.aws/
/.ssh/
/.netrc
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Python bytecode, caches, virtual environments, and build output
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
test-results/
.tox/
.nox/
.venv/
.venv-*/
venv/
venv-*/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Runtime state, logs, uploads, and generated reports
# -----------------------------------------------------------------------------
.cache/
.run/
.tmp/
tmp/
temp/
logs/**
!logs/**/
*.log
*.pid
*.pid.lock
baselines/**
!baselines/**/
outputs/
artifacts/
/uploads/
/local-data/
/reports/
/scratch/
*.log.*
*.stackdump
core.[0-9]*
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Keep optional placeholders if these directories later need to exist in Git.
!logs/.gitkeep
!baselines/.gitkeep

# -----------------------------------------------------------------------------
# Model weights and downloaded ML artifacts
# Keep only directory placeholders; model binaries must be deployed separately.
# -----------------------------------------------------------------------------
weights/**
!weights/**/
!weights/**/.gitkeep

*.pdiparams
*.pdparams
*.pdmodel
*.pdopt
*.pdiparams.info
*.onnx
*.engine
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.gguf

# Paddle/PaddleX and Hugging Face caches
.paddlex/
.paddleocr/
.huggingface/
/checkpoints/
/wandb/
/mlruns/
/runs/

# -----------------------------------------------------------------------------
# Notebook, editor, and operating-system files
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
.idea/
.vscode/
/.codex/
/.agents/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# Local container overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# -----------------------------------------------------------------------------
# Markdown documentation (keep README.md in otherwise tracked directories)
# -----------------------------------------------------------------------------
*.[mM][dD]
![rR][eE][aA][dD][mM][eE].[mM][dD]
