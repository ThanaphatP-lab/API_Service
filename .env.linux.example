# Copy to .env.runtime on the Linux server and replace both secrets.
APP_ENV=production
API_DOCS_ENABLED=false
LEGACY_ENDPOINTS_ENABLED=false
MODEL_DEVICE=gpu:0
PADDLE_PDX_MODEL_SOURCE=BOS

MODEL_GATEWAY_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
MODEL_GATEWAY_API_KEY_PREVIOUS=
INTERNAL_API_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
INTERNAL_API_TOKEN_PREVIOUS=

# Keep every process private; expose HTTPS through Nginx/managed ingress only.
INTERNAL_SERVICE_HOST=127.0.0.1
GATEWAY_HOST=127.0.0.1
DEMO_HOST=127.0.0.1
TRUST_PROXY_HEADERS=true

GATEWAY_ENABLED_PIPELINES=all
GATEWAY_REQUIRED_PIPELINES=
GATEWAY_READINESS_TIMEOUT_SECONDS=120

# Linux launcher exports TEXT_DETECTION_URL from DETECTION_PORT automatically.
# Set TEXT_DETECTION_URL only for a separately managed/remote DET service.
# SERVICES names override the legacy PIPELINES configuration when supplied.
# GATEWAY_ENABLED_SERVICES=leaf-text-detection,leaf-text-recognition,pipeline-ocr-custom
# GATEWAY_REQUIRED_SERVICES=leaf-text-detection,leaf-text-recognition
# See PHASE5_TOPOLOGY.md; no process/port changes are automatic.

# Optional TableRecognitionPipelineV2 overrides from notebook (4).
TABLE_V2_WIRED_MODEL_NAME=SLANeXt_wired
TABLE_V2_WIRELESS_MODEL_NAME=SLANeXt_wireless
TABLE_V2_OCR_VERSION=v5
TABLE_V2_MODEL_CACHE_SIZE=2
TABLE_V2_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
TABLE_V2_TEXT_RECOGNITION_MODEL_NAME=th_PP-OCRv5_mobile_rec

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RATE_LIMIT_KEYS=10000
MAX_REQUEST_MB=28
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_BATCH_IMAGES=64
MAX_BATCH_UPLOAD_MB=64
# Must not exceed MAX_BATCH_IMAGES on the recognition leaf.
OCR_RECOGNITION_BATCH_SIZE=64
# REC fair scheduling: images per turn, not GPU batch size or HTTP requests.
REC_FAIR_CHUNK_SIZE=20
# Completion summaries replace duplicate Uvicorn access lines. Debug details
# and process resource snapshots are available with uvicorn --log-level debug.
API_ACCESS_LOG=false
# Internal model batches; API request limits remain MAX_BATCH_IMAGES.
LAYOUT_BATCH_SIZE=1
SIGLIP_BATCH_SIZE=4
# Official PaddleOCR: default generation for direct variant-only requests.
# Requests without a selection keep the existing DET/REC environment models.
PADDLE_OCR_VERSION=v5
# Each cached pipeline can hold its own DET + REC weights in GPU memory.
PADDLE_OCR_MODEL_CACHE_SIZE=2
REC_QUEUE_MAX_JOBS=16
REC_QUEUE_MAX_IMAGES=256
REC_QUEUE_MAX_MB=256
REC_JOB_TIMEOUT_SECONDS=180
REC_MAX_CONCURRENT_REQUESTS=16
OCR_MAX_CONCURRENT_REQUESTS=4
# REC_BATCH_SIZE (default 8) remains the model's internal inference batch size.
MAX_CONCURRENT_REQUESTS=1
GATEWAY_MAX_CONCURRENT_REQUESTS=4
INFERENCE_QUEUE_TIMEOUT_SECONDS=5
DEBUG_ERRORS=false

# Process manager behavior.
STARTUP_WAIT_SECONDS=45
SHUTDOWN_WAIT_SECONDS=30
READINESS_TIMEOUT_SECONDS=300

# Optional. Defaults are already isolated under this deployment directory:
# MODEL_CACHE_DIR=/absolute/path/to/this-deployment/models/.cache
# MODEL_TMP_DIR=/absolute/path/to/this-deployment/models/.tmp

# Optional port overrides for bare-metal Linux deployment.
LAYOUT_PORT=8001
DETECTION_PORT=8002
REC_TH_PORT=8004
OCR_CUSTOM_PORT=8005
OCR_PADDLE_PORT=8006
TABLE_WIRED_PORT=8007
TABLE_WIRELESS_PORT=8008
SIGLIP_PORT=8009
LAYOUT_PIPELINE_PORT=8010
TABLE_PIPELINE_PORT=8011
IMAGE_VERIFICATION_PORT=8012
TABLE_V2_PORT=8013
GATEWAY_PORT=8080
DEMO_PORT=8501
